// Version info, manifest and dialogs for MechanoZip.exe
#include <winver.h>
#include <winuser.h>
#include <commctrl.h>
#include "resource.h"
#include "version.h"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

// App icon (made by make-icon.ps1). The first icon in the file is the one Explorer shows.
IDI_APP ICON "app.ico"

IDD_PASSWORD DIALOGEX 0, 0, 260, 92
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Password required"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Enter the password for this archive:", IDC_PW_TEXT, 10, 10, 240, 18
    EDITTEXT        IDC_PW_EDIT, 10, 32, 240, 14, ES_PASSWORD | ES_AUTOHSCROLL
    AUTOCHECKBOX    "Show password", IDC_PW_SHOW, 10, 52, 120, 12
    DEFPUSHBUTTON   "OK", IDOK, 146, 70, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 200, 70, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MZR_VER_MAJOR,MZR_VER_MINOR,MZR_VER_PATCH,MZR_VER_BUILD
 PRODUCTVERSION MZR_VER_MAJOR,MZR_VER_MINOR,MZR_VER_PATCH,MZR_VER_BUILD
 FILEFLAGSMASK 0x3fL
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "Mechano (" MZR_AUTHOR ")"
      VALUE "FileDescription",  MZR_PRODUCT_NAME
      VALUE "FileVersion",      MZR_VERSION_STR
      VALUE "InternalName",     "MechanoZip"
      VALUE "LegalCopyright",   MZR_COPYRIGHT
      VALUE "OriginalFilename", "MechanoZip.exe"
      VALUE "ProductName",      MZR_PRODUCT_NAME
      VALUE "ProductVersion",   MZR_VERSION_STR " " MZR_VER_LABEL
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
